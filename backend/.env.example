# GitHub OAuth App 凭据
# 创建 OAuth App: https://github.com/settings/developers
# Authorization callback URL: http://localhost:8000/api/auth/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/callback
FRONTEND_URL=http://localhost:5173

# 自定义提供商加密密钥（至少 16 字符）
ENCRYPTION_SECRET=change-me-to-a-random-string

# LLM API Keys（至少配一个）
DEEPSEEK_API_KEY=sk-your-deepseek-key
DOUBAO_API_KEY=your-doubao-key
OPENAI_API_KEY=sk-your-openai-key
