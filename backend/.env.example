# GitHub OAuth App 凭据（必填）
# 创建 OAuth App: https://github.com/settings/developers
# Authorization callback URL: http://localhost:8000/api/auth/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/callback
FRONTEND_URL=http://localhost:8000

# ── LLM API Keys（可选）─────────────────────────
# 默认使用本地 Ollama（离线），无需填写以下 Key
# 如需在线模型，在 Settings 页面配置或取消注释：
# DEEPSEEK_API_KEY=
# DOUBAO_API_KEY=
# OPENAI_API_KEY=

# ── 加密密钥 ─────────────────────────────────────
# 运行以下命令生成：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_SECRET=change-me-to-a-valid-fernet-key

# 旧版 XOR 加密数据迁移密钥（仅在从旧版本升级时需要，可留空）
# ENCRYPTION_LEGACY_KEY=
