# GitHub OAuth App 凭据
# 创建 OAuth App: https://github.com/settings/developers
# Authorization callback URL: http://localhost:8000/api/auth/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/callback
FRONTEND_URL=http://localhost:8000

# 自定义提供商加密密钥（运行以下命令生成）
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_SECRET=change-me-to-a-valid-fernet-key

# 旧版 XOR 加密数据迁移密钥（仅在从旧版本升级时需要，可留空）
# ENCRYPTION_LEGACY_KEY=

# LLM API Keys（至少配一个）
DEEPSEEK_API_KEY=sk-your-deepseek-key
DOUBAO_API_KEY=your-doubao-key
OPENAI_API_KEY=sk-your-openai-key
